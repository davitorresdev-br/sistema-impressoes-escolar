# Copie este arquivo para ".env" (sem o ".example") e preencha com os
# valores reais. O ".env" NUNCA deve ser commitado no Git — ele já está
# protegido no .gitignore da raiz do projeto.

# ID do cliente OAuth do Google Workspace (não é secreto, mas fica mais
# fácil de trocar aqui do que editando o código).
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Chave que o agente de impressão (no computador do colégio) usa para se
# autenticar nas rotas /api/agente/*. Precisa ser EXATAMENTE igual à
# AGENTE_API_KEY configurada no .env do agente_impressao.py. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
AGENTE_API_KEY=

# Chave usada para ASSINAR os tokens de sessão dos usuários que fazem
# login (professores e TI). Mantenha-a secreta: quem souber este valor
# consegue forjar um login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
ACALANTO_SECRET_KEY=

# (Opcional) Restringe o CORS a origens específicas, separadas por
# vírgula — ex.: http://192.168.0.10:5173,http://meu-dominio. O padrão
# "*" libera qualquer origem (cômodo na rede interna, menos seguro).
ACALANTO_CORS_ORIGINS=*

# (Opcional) COTA mensal em FOLHAS DE PAPEL por usuário. 0 = ilimitado.
# Quando > 0, o envio que estouraria o limite no mês é recusado, com
# mensagem orientando procurar o T.I. A unidade é folha (e não "impressões"
# = páginas × cópias) porque folha é o que a escola compra — e porque em
# folhas o frente-e-verso consome metade da cota, o que já é um incentivo.
# O nome antigo (ACALANTO_LIMITE_MENSAL_IMPRESSOES) continua sendo aceito.
ACALANTO_LIMITE_MENSAL_FOLHAS=0

# (Opcional) TETO DE FOLHAS POR ENVIO. A regra do colégio é 500 por pedido;
# acima disso é tiragem grande, que passa pelo T.I. 0 desliga o teto.
ACALANTO_MAX_FOLHAS=500

# (Opcional) AUTO-CADASTRO de professores: "aberto" (padrão) deixa qualquer
# pessoa que alcance o servidor criar a própria conta; "fechado" faz as
# contas nascerem só pelo painel do T.I. Numa rede em que os alunos têm
# Wi-Fi, "aberto" é uma porta de entrada real — recomendamos "fechado".
#ACALANTO_AUTOCADASTRO=fechado

# (Opcional) Tamanho mínimo de senha. 8 é o padrão; abaixo disso, senha
# curta somada a rede de escola é força bruta em minutos.
#ACALANTO_SENHA_MINIMA=8

# (Opcional) Limite de tentativas de login erradas por conta e por IP,
# dentro da janela em segundos. Padrão: 5 tentativas em 300s.
#ACALANTO_LOGIN_MAX_TENTATIVAS=5
#ACALANTO_LOGIN_JANELA_SEGUNDOS=300

# (Opcional) Depois de quantos minutos em "Imprimindo" um pedido é
# considerado preso (o agente caiu no meio) e devolvido à fila. Padrão: 20.
#ACALANTO_MINUTOS_PEDIDO_PRESO=20

# (Opcional) Quantos pedidos o agente recebe por ciclo. Padrão: 20 — evita
# que 200 pedidos represados de uma noite ocupem a Konica por horas.
#ACALANTO_LOTE_AGENTE=20

# (Opcional) Arquivo de log do servidor (rotativo, 5 MB × 5).
#ACALANTO_LOG=servidor.log

# ---------------------------------------------------------------------
# HOSPEDAGEM EM VM (docs/MIGRACAO-VM-WINDOWS.md ou docs/MIGRACAO-UBUNTU.md)
# ---------------------------------------------------------------------
# Onde o servidor escuta. O padrão 0.0.0.0 é o certo quando ele atende
# direto (como no Windows hoje). Com nginx na frente, 127.0.0.1 fecha o
# acesso à porta 8080 para tudo que não seja o próprio proxy.
#ACALANTO_HOST=127.0.0.1
#ACALANTO_PORT=8080

# Ligue SOMENTE quando houver mesmo um proxy reverso (nginx) na frente.
# Ligado, o sistema passa a confiar no cabeçalho X-Forwarded-For para saber
# o IP de quem acessa — o que é ESSENCIAL ali: sem isso todo mundo chega
# como 127.0.0.1 e cinco senhas erradas de uma pessoa trancariam o login do
# colégio inteiro. Ligado SEM proxy, é o contrário: qualquer cliente
# forjaria o próprio IP e escaparia do limite.
#ACALANTO_ATRAS_DE_PROXY=true

# (Opcional) RETENÇÃO: dias após os quais o conteúdo de um PDF já impresso
# é descartado (mantendo registro e hash para auditoria). 0 = nunca. A
# limpeza roda quando o servidor inicia.
ACALANTO_RETENCAO_DIAS=0

# (Opcional) HORÁRIO DE IMPRESSÃO, formato HH:MM. Aqui o servidor só usa
# para avisar o professor ("fora do horário, será impresso a partir das…").
# Quem de fato segura os pedidos é o agente — configure os MESMOS valores
# no agente.env do PC da impressora, senão o sistema promete um horário e
# cumpre outro.
#HORARIO_INICIO_IMPRESSAO=08:00
#HORARIO_FIM_IMPRESSAO=18:00

# true = não imprime sábado nem domingo. Padrão: imprime todos os dias.
#HORARIO_SO_DIAS_UTEIS=false

# MODO DE DESENVOLVIMENTO: ignora a faixa de horário E FECHA O SISTEMA —
# com ele ligado, só o administrador-mestre (super_admin) consegue entrar:
# o login e o auto-cadastro dos demais são recusados com mensagem de
# manutenção, e sessões já abertas deixam de valer enquanto o modo durar.
# Quem de fato libera a impressão fora de hora é o MESMO ajuste no
# agente.env. NUNCA deixe ligado em produção.
#MODO_DESENVOLVIMENTO=true

# "true" liga o modo debug do Flask (NUNCA deixe true se o servidor for
# acessível pela rede do colégio — o debug do Flask permite execução de
# código arbitrário se alguém achar uma página de erro).
ACALANTO_DEBUG=false

# Senha inicial da conta "admin" (usada só na criação do banco).
# Se ficar vazia, uma senha aleatória é gerada e mostrada no terminal.
ADMIN_SENHA_INICIAL=
