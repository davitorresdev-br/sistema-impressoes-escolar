# Este arquivo é do AGENTE (roda no computador do colégio), separado do
# .env do app.py (que roda no Discloud). Copie para "agente.env" nesta
# mesma pasta — é ESSE o nome que o agente lê (não ".env").

# (Opcional) Endereço do servidor, sem a barra "/" no final. Deixe em
# branco (ou remova a linha) para usar o servidor DESTA mesma máquina
# (http://localhost:8080) — o arranjo padrão do colégio. Só preencha
# quando o app.py estiver em outro lugar (ex.: hospedado no Discloud).
#CLOUD_URL=https://sua-app.discloud.app

# Precisa ser EXATAMENTE a mesma chave configurada no .env do app.py
# (variável AGENTE_API_KEY lá também). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
AGENTE_API_KEY=

# Cada quantos segundos o agente verifica se chegou pedido novo.
AGENTE_INTERVALO_SEGUNDOS=15

# Fora do horário de impressão não há o que fazer a cada 15s — o agente
# dorme este tempo (padrão 120s) e registra no máximo uma linha por
# transição, em vez de encher o log com milhares de "aguardando".
#AGENTE_INTERVALO_OCIOSO=120

# ---------------------------------------------------------------------
# Horário de impressão
# ---------------------------------------------------------------------
# Formato HH:MM. Precisa ser IGUAL ao configurado no .env do servidor: é o
# app.py que promete ao professor a que horas o pedido vai sair, e é este
# agente que cumpre. Valores diferentes = promessa quebrada.
#HORARIO_INICIO_IMPRESSAO=08:00
#HORARIO_FIM_IMPRESSAO=18:00

# true = não imprime sábado nem domingo. Padrão: imprime todos os dias.
#HORARIO_SO_DIAS_UTEIS=false

# MODO DE DESENVOLVIMENTO: ignora a faixa de horário, para testar fora do
# expediente sem precisar mexer (e depois desmexer) nos horários acima.
#
# Só afeta o horário. Ligado, o agente IMPRIME DE VERDADE na Konica — não é
# um modo que simula ou desvia impressão. Os dois processos gritam no
# console na inicialização enquanto isto estiver ligado.
#
# NUNCA deixe ligado em produção: o sistema passa a imprimir de madrugada e
# no fim de semana, e o único sintoma é papel saindo fora de hora.
#MODO_DESENVOLVIMENTO=true

# ---------------------------------------------------------------------
# Filas de impressão do Windows
# ---------------------------------------------------------------------
# São só DUAS filas. Cor e frente e verso vão no comando do SumatraPDF, a
# cada trabalho; só o grampo precisa de fila própria, porque não existe
# campo padrão do Windows para ele (é área privada do driver da Konica).
#
# Os nomes precisam ser EXATAMENTE os que aparecem em:
#   Get-Printer | Select-Object Name
# Em impressora compartilhada o nome inclui o caminho do servidor
# (\\servidor\fila) — só o nome curto NÃO funciona.
#
# Deixe comentado para usar o padrão que está em automacao_impressora.py.
#IMPRESSORA_FILA_NORMAL=\\SERVIDOR\Impressora (Normal)
#IMPRESSORA_FILA_GRAMPO=\\SERVIDOR\Impressora (Grampo)

# Caminho do SumatraPDF.exe. Por padrão o agente procura na raiz do projeto.
#SUMATRAPDF_EXE=C:\Ferramentas\SumatraPDF.exe

# Teto para o SumatraPDF entregar o trabalho ao spooler (não é o tempo de
# impressão física). Existe para o agente não travar se algo emperrar.
#IMPRESSORA_TIMEOUT_SEGUNDOS=300

# Depois de entregar, o agente observa a fila do servidor por este tempo
# para pegar trabalho que empaca (papel acabou, atolou, fila pausada). Ele
# para antes se a fila esvaziar. Só reporta erro quando o spooler diz
# explicitamente que travou — trabalho ainda imprimindo não é falha.
# 0 desliga a verificação.
#IMPRESSORA_VIGIA_SEGUNDOS=10
